# Environment variables for Matchwerk.
#
# This project uses TWO env files (both gitignored):
#   .env        -> DATABASE_URL  (Prisma reads .env, not .env.local)
#   .env.local  -> ANTHROPIC_API_KEY  (your secret API key)
#
# Copy the relevant lines into those files and fill in the values.

# --- .env ---
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://jobhunter:jobhunter@localhost:5433/jobhunter?schema=public"

# --- .env.local ---
# AI provider keys for CV parsing + job match scoring. These are FALLBACKS —
# once a key is saved in Admin → System Settings it lives in the DB and wins.
# Get an Anthropic key at https://console.anthropic.com/ and a Gemini key at
# https://aistudio.google.com/apikey . NEVER commit the real values.
ANTHROPIC_API_KEY=""
# Optional — enables the Gemini Flash provider (switch/fallback in admin).
GEMINI_API_KEY=""

# --- Auth.js (NextAuth) ---
# Required. Signs session JWTs. Generate one with: npx auth secret
# (or: openssl rand -base64 33). NEVER commit the real value.
AUTH_SECRET=""

# --- Password reset email (optional) ---
# The forgot-password reset email is delivered by, in order: (1) SMTP if enabled
# in Admin → System Settings → Email, (2) Resend if RESEND_API_KEY is set,
# (3) otherwise the link is logged to the server console (dev only).
#
# SMTP host/port/user/from are configured in the admin UI; only the SMTP password
# has an env fallback here. Resend: get a key at https://resend.com .
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="Matchwerk <onboarding@resend.dev>"

# Admin backoffice — comma-separated emails that should be SUPER_ADMIN. These
# accounts are promoted automatically on sign-in (and can manage other admins).
# Use your own app login email here.
SUPER_ADMIN_EMAILS=""

# Google sign-in (optional — email/password registration works without it).
# Create an OAuth client in Google Cloud Console > APIs & Services > Credentials
# (type "Web application"). Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Source API credentials (FALLBACKS) ---
# These are read at startup as fallbacks. Once you save a key via
# Settings → API credentials in the app, the DB value wins over these and
# you can leave the env entry blank.

# JSearch — primary job aggregator (LinkedIn, Indeed, Glassdoor, ZipRecruiter).
# RapidAPI key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=""

# Fantastic.jobs / Active Jobs DB — primary aggregator. 3M+ ATS career-site
# listings (Workday, Greenhouse, Ashby, …), refreshed hourly.
# RapidAPI key: https://rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/active-jobs-db
FANTASTIC_JOBS_API_KEY=""

# Adzuna — backup source (Germany/EU). Free credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Jooble — backup aggregator with strong EU coverage. Free key from your
# Jooble account dashboard: https://jooble.org/api/about
JOOBLE_API_KEY=""

# --- Stripe (token purchases) ---
# Test keys (sk_test_…) work out of the box. LIVE keys (sk_live_…) charge real
# money and are accepted ONLY when STRIPE_ALLOW_LIVE=true is also set (so a live
# key can't start real charges by accident). Keys: Stripe Dashboard → Developers
# → API keys (toggle Test/Live).
STRIPE_SECRET_KEY=""
# Set to "true" in production ONLY, alongside a sk_live_ key, to enable real
# charges. Leave unset/anything-else for test mode.
STRIPE_ALLOW_LIVE=""
# Webhook signing secret for POST /api/stripe/webhook.
#   • Local/test: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#     and copy the printed "whsec_…". (Optional locally — the success redirect
#     also confirms + credits the session, idempotently.)
#   • Live: Dashboard (Live) → Developers → Webhooks → add endpoint
#     https://<your-domain>/api/stripe/webhook (event checkout.session.completed),
#     then copy that endpoint's "whsec_…".
STRIPE_WEBHOOK_SECRET=""
