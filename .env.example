# Environment variables for Job Hunter.
#
# This project uses TWO env files (both gitignored):
#   .env        -> DATABASE_URL  (Prisma reads .env, not .env.local)
#   .env.local  -> ANTHROPIC_API_KEY  (your secret API key)
#
# Copy the relevant lines into those files and fill in the values.

# --- .env ---
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://jobhunter:jobhunter@localhost:5433/jobhunter?schema=public"

# --- .env.local ---
# Anthropic API key for CV parsing + job match scoring.
# Get one at https://console.anthropic.com/ . NEVER commit the real value.
ANTHROPIC_API_KEY=""

# --- Source API credentials (FALLBACKS) ---
# These are read at startup as fallbacks. Once you save a key via
# Settings → API credentials in the app, the DB value wins over these and
# you can leave the env entry blank.

# JSearch — primary job aggregator (LinkedIn, Indeed, Glassdoor, ZipRecruiter).
# RapidAPI key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=""

# Fantastic.jobs / Active Jobs DB — primary aggregator. 3M+ ATS career-site
# listings (Workday, Greenhouse, Ashby, …), refreshed hourly.
# RapidAPI key: https://rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/active-jobs-db
FANTASTIC_JOBS_API_KEY=""

# Adzuna — backup source (Germany/EU). Free credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
