// Matchwerk — multi-tenant AI job search app.
// Every data model (Profile, Settings, Job, SourceCredential) is scoped to a User.
// Auth is handled by Auth.js (NextAuth v5) with Google + Credentials providers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobSourceId {
  BA_JOBBOERSE
  JSEARCH
  ADZUNA
  JOBSPY
  FANTASTIC_JOBS
  // Legacy values kept so historical rows stay valid; no longer surfaced in the UI.
  INDEED
  LINKEDIN
  STEPSTONE
  XING
  GLASSDOOR
  MONSTER
}

enum JobStatus {
  NEW
  STARRED
  APPLIED
  DELETED
}

/// Platform access level. USER = normal client. ADMIN = full backoffice access
/// except managing admins. SUPER_ADMIN = everything, including managing admins.
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  LEAD
  UNKNOWN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  UNKNOWN
}

/// An authenticated account. `password` is null for OAuth-only (Google) users
/// and a bcrypt hash for email/password users.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Backoffice access level and activation state. `disabledAt` is null for active
  // accounts; setting it deactivates the user (blocks sign-in + all API access).
  role       UserRole  @default(USER)
  disabledAt DateTime?

  // Token billing. Balances use 0.5 increments (hence Float). `tokenDebt` records
  // overspend beyond a zeroed balance so the UI never shows a negative number.
  // `tokensGrantedAt` is null until the one-time signup grant is applied.
  tokenBalance    Float     @default(0)
  tokenDebt       Float     @default(0)
  tokensGrantedAt DateTime?

  accounts    Account[]
  sessions    Session[]
  profile     Profile?
  settings    Settings?
  jobs        Job[]
  credentials SourceCredential[]
  ledger      TokenLedger[]
}

/// Append-only audit trail of token grants/charges. One row per action (not per
/// job) — the per-job breakdown lives in `metadata`.
model TokenLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Float // negative = charge, positive = grant
  balanceAfter Float
  reason       String // "signup_grant" | "cv_parse" | "research" | "purchase"
  metadata     Json?
  // Set only on token purchases. Unique so a Stripe Checkout session can be
  // credited at most once, no matter how many times the webhook + success
  // redirect both fire (idempotency key for crediting).
  stripeSessionId String? @unique
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Append-only record of privileged backoffice actions (token grants, status
/// changes, role changes, etc.). Self-contained — stores actor/target ids AND
/// emails so the trail survives if a referenced user is later deleted.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String
  targetId    String?
  targetEmail String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// Admin-posted announcement shown as an in-app banner to all users. `level`
/// is "info" | "warning"; an optional [startsAt, endsAt] window gates display.
model Announcement {
  id        String    @id @default(cuid())
  message   String
  level     String    @default("info")
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

/// Verified Stripe webhook events, for the admin inspector. PK is the Stripe
/// event id so retries upsert the same row (idempotent storage).
model WebhookEvent {
  id        String   @id
  type      String
  status    String // "processed" | "ignored" | "error"
  summary   String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Lightweight log of outbound AI requests (one row per provider attempt,
/// including fallbacks). Powers the admin analytics: provider usage, failed
/// requests, and error logs. Append-only; not user-scoped.
model RequestLog {
  id         String   @id @default(cuid())
  kind       String   @default("ai")
  provider   String?
  operation  String?
  ok         Boolean
  durationMs Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}

/// Global platform key/value config (active AI provider, fallback order,
/// per-provider enable flags, etc.). Admin-managed; non-secret.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Global platform secrets — AI and job-source API keys, managed in admin.
/// Keyed by canonical env-var name; resolution is DB row → process.env fallback.
/// Never returned raw over the wire (masked tails only).
model PlatformCredential {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A token purchase plan shown on /plans and used by Stripe checkout.
/// Admin-editable (Phase 4) — was previously hardcoded in src/lib/plans.ts.
/// `id` is a stable slug ("starter"/"plus"/"pro" or custom) referenced by
/// Stripe session metadata, so it must not change once a purchase exists.
model Plan {
  id             String   @id
  name           String
  tagline        String   @default("")
  priceEur       Float
  tokens         Int
  durationMonths Int
  recommended    Boolean  @default(false)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// Auth.js linked OAuth account (e.g. Google).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js DB session row. Unused under the JWT strategy, but kept so the
/// Prisma adapter contract is satisfied.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js verification token (email flows). Present for adapter completeness.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Parsed CV profile. One per user — replaced wholesale on new CV upload.
/// `userId` is nullable only so legacy single-tenant rows survive migration as
/// orphans until claimed by the first user; app code always scopes by userId.
model Profile {
  id              String    @id @default(cuid())
  userId          String?   @unique
  fileName        String
  rawCvText       String
  summary         String
  skills          String[]
  tools           String[]
  industries      String[]
  keywords        String[]
  seniority       Seniority @default(UNKNOWN)
  yearsExperience Int       @default(0)
  parsedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// User search preferences. One per user.
model Settings {
  id               String        @id @default(cuid())
  userId           String?       @unique
  jobTitles        String[]
  defaultLocations String[]
  defaultSeniority Seniority[]
  defaultJobTypes  JobType[]
  defaultSources   JobSourceId[]
  updatedAt        DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// API credentials per source, per user. Adapters fall back to process.env when
/// no row exists. UI never reads `secrets` directly — only a masked tail is
/// exposed over the wire.
model SourceCredential {
  id        String      @id @default(cuid())
  userId    String?
  sourceId  JobSourceId
  secrets   Json
  updatedAt DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
}

/// A job listing. Deleted jobs keep their row so dedupe permanently excludes them.
model Job {
  id          String      @id @default(cuid())
  userId      String?
  source      JobSourceId
  externalId  String
  dedupeHash  String
  title       String
  company     String
  location    String
  url         String
  /// Underlying platform an aggregator sourced the job from (e.g. "LinkedIn", "Indeed").
  publisher   String?
  description String      @default("")
  jobType     JobType     @default(UNKNOWN)
  seniority   Seniority   @default(UNKNOWN)
  publishedAt DateTime?

  matchScore       Int?
  matchExplanation String?
  missingSkills    String[]
  scoredAt         DateTime?

  status    JobStatus @default(NEW)
  appliedAt DateTime?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeHash])
  @@index([userId, status])
  @@index([status])
  @@index([source])
}
